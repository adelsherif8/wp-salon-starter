{
  "name": "wp-salon-starter",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i salon-master/assets/src/input.css -o salon-master/assets/app.css --minify",
    "watch": "tailwindcss -i salon-master/assets/src/input.css -o salon-master/assets/app.css --watch",
    "wp:start": "wp-env start",
    "wp:stop": "wp-env stop",
    "wp:seed": "wp-env run cli wp eval-file wp-content/themes/salon-master/demo/seed.php"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.15",
    "@wordpress/env": "10.14.0",
    "tailwindcss": "3.4.17"
  }
}
